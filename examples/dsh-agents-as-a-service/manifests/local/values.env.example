# Local, cluster-specific values for the agents-as-a-service example.
# Copy to values.env (git-ignored), edit, then run:
#   ./scripts/local-overlay.sh              # print the kubectl patches
#   ./scripts/local-overlay.sh --apply      # apply them (idempotent)
#
# Never put Secrets in this file: it is tracked-by-copy guidance, not storage.
# Empty values are skipped; the shipped manifest value stays.

# Namespace the base manifests were applied to.
NAMESPACE=dsh-demo
# Names of the shipped resources the overlay patches.
TEMPLATE_NAME=dsh-web
POOL_NAME=dsh-pool
GATEWAY_DEPLOY=dsh-gateway
OAUTH_DEPLOY=oauth2-proxy

# --- Sandbox template and warm pool ---------------------------------------

# Warm-pool spares to keep Ready (repo default: 2).
WARM_POOL_REPLICAS=2

# gVisor RuntimeClass (empty keeps the base manifest's unset runtimeClassName).
RUNTIME_CLASS=gvisor

# Node pool for sandboxes. Set both keys or neither; empty leaves scheduling
# to the cluster. Prefer a node label over a hard-coded hostname affinity.
NODE_SELECTOR_KEY=dsh.example.com/node-pool
NODE_SELECTOR_VALUE=dsh

# Public hostname(s) DSH must trust (comma-separated, exactly what DSH's
# DSH_TRUSTED_HOSTS expects). Empty keeps the base manifest's empty value.
DSH_TRUSTED_HOSTS=dsh.example.com

# Per-user workspace PVC. Empty STORAGE_CLASS keeps the cluster default class
# (recommended: a Delete-reclaim class). Empty STORAGE_SIZE keeps 5Gi.
STORAGE_CLASS=
STORAGE_SIZE=5Gi
FAILED_POD_POLICY=Recreate

# --- Gateway ---------------------------------------------------------------

# Empty image keeps the release tag from the shipped manifest. Pin a digest
# for reproducible rollouts; do not use a mutable dev tag.
GATEWAY_IMAGE=
GATEWAY_IMAGE_PULL_POLICY=IfNotPresent
# Readiness probe path. Leave empty unless the deployed gateway image serves
# the API-aware endpoint (gateway builds after this change). An older image
# answers 404 on /readyz and the pod would never become Ready.
GATEWAY_READINESS_PATH=
IDLE_TIMEOUT=360
WAKE_TIMEOUT=240

# SSO over the gateway: identity header, Secure cookie, and the number of
# proxies that append to X-Forwarded-For between the browser and the gateway
# (2 for the shipped Traefik + oauth2-proxy chain). Leave AUTH_PROXY_HEADER
# empty for the non-SSO ingress variant.
TRUSTED_PROXY_HOPS=2
AUTH_PROXY_HEADER=X-Forwarded-User
COOKIE_SECURE=true

# --- SSO exposure variant (only patched when the objects exist) -----------

# TODO: replace with the GitHub organization allowed to sign in.
OAUTH2_GITHUB_ORG=your-github-org
OAUTH2_EMAIL_DOMAIN=example.com
# TODO: replace with the public callback URL of the OAuth App.
OAUTH2_REDIRECT_URL=https://dsh.example.com/oauth2/callback
# Public hostname on the HTTPRoute.
PUBLIC_HOST=dsh.example.com
# Namespace the Gateway implementation (Traefik) runs in; scopes the
# oauth2-proxy ingress policy. On k3s it is kube-system.
TRAEFIK_NAMESPACE=kube-system
